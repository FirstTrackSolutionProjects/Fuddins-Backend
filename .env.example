PORT=5000
HOST=0.0.0.0
DATABASE_URL=
DB_CREATE_DATABASE=true
DB_SYNC_ALTER=true
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
JWT_SECRET=change-this-secret
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-admin-password
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_test_key_secret
RAZORPAY_WEBHOOK_SECRET=choose-a-separate-webhook-secret
SMTP_HOST=smtp.hostinger.com
# Port 587 uses STARTTLS and is generally reachable from hosted platforms.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=your-rotated-hostinger-mail-password
EMAIL_FROM="Fuddins <info@yourdomain.com>"
ORDER_NOTIFICATION_EMAIL=info@yourdomain.com
OTP_SECRET=use-a-separate-long-random-secret-for-otp-hashing
OTP_DEBUG_RESPONSE=false
REWARD_POINTS_PER_RUPEE=0.1
PHONE_DEFAULT_COUNTRY_CODE=+91
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com,your-google-android-client-id.apps.googleusercontent.com
NODE_ENV=development

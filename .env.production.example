NODE_ENV=production
PORT=5000
HOST=0.0.0.0

DB_HOST=your-public-mysql-host
DB_PORT=3306
DB_NAME=ftech_db
DB_USER=your-db-user
DB_PASSWORD=your-db-password
DB_CREATE_DATABASE=false
DB_SYNC_ALTER=false
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=true

JWT_SECRET=replace-with-a-long-random-secret

ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-admin-password

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SMTP_HOST=smtp.hostinger.com
# Port 587 uses STARTTLS and is generally reachable from hosted platforms.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=replace-with-mailbox-password
EMAIL_FROM="Fuddins <info@yourdomain.com>"
ORDER_NOTIFICATION_EMAIL=info@yourdomain.com

OTP_SECRET=replace-with-a-separate-long-random-secret
OTP_DEBUG_RESPONSE=false
PHONE_DEFAULT_COUNTRY_CODE=+91
# Required for real phone OTP delivery.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Comma-separated Google OAuth client IDs allowed by the API.
GOOGLE_CLIENT_IDS=your-google-web-client-id.apps.googleusercontent.com,your-google-android-client-id.apps.googleusercontent.com
